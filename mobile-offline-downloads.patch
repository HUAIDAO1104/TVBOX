+    @Test public void pauseResumeUsesDownloadedRangesAndPersistsTheStopReason() throws Exception {
+        byte[] large = new byte[4 * 1024 * 1024]; new Random(42).nextBytes(large); content.put("/large.mp4", large); slow = true;
