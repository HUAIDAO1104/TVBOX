diff --git a/app/build.gradle b/app/build.gradle
index e05c8c5..21e0e85 100644
--- a/app/build.gradle
+++ b/app/build.gradle
@@ -19,8 +19,8 @@ android {
         testInstrumentationRunner "androidx.test.runner.AndroidJUnitRunner"
         // Keep compatibility fixes on a strictly newer version so TV installers do not retain
         // the previous APK while preserving its database for the migration chain below.
-        versionCode 640
-        versionName "5.5.89"
+        versionCode 641
+        versionName "5.5.90"
         javaCompileOptions {
             annotationProcessorOptions {
                 arguments = ["room.schemaLocation": "$projectDir/schemas".toString(), "eventBusIndex": "com.fongmi.android.tv.event.EventIndex"]
@@ -52,7 +52,13 @@ android {
         viewBinding = true
     }
 
+    testOptions {
+        unitTests.includeAndroidResources = true
+        unitTests.all { test -> if (test.name.contains('Mobile')) test.maxHeapSize = '2g' }
+    }
+
     sourceSets {
+        testMobile.resources.srcDirs += files("src/androidTestMobile/assets")
         androidTest.assets.srcDirs += files("$projectDir/schemas")
 
         // Each mode owns its presentation; networking, search and playback stay in main.
@@ -173,6 +179,8 @@ dependencies {
     annotationProcessor libs.glide.compiler
     coreLibraryDesugaring libs.desugar
     testImplementation 'junit:junit:4.13.2'
+    testMobileImplementation 'org.robolectric:robolectric:4.16.1'
+    testMobileImplementation 'androidx.test:core:1.7.0'
     testImplementation 'com.squareup.okhttp3:mockwebserver:5.4.0'
     androidTestImplementation 'androidx.test:core:1.7.0'
     androidTestImplementation 'androidx.test:runner:1.7.0'
