<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tv_home_background"
    android:clipChildren="false"
    android:clipToPadding="false">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/tv_home_vignette"
        android:importantForAccessibility="no" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/home_safe_start"
        android:paddingTop="24dp"
        android:paddingEnd="@dimen/home_safe_end"
        android:paddingBottom="22dp">

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="@string/search_v2_title"
            android:textColor="@color/tv_text_primary"
            android:textSize="@dimen/tv_text_page_title"
            android:textStyle="bold" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/searchBox"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/shape_search_v2_input"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="10dp">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/voiceAction"
                android:layout_width="112dp"
                android:layout_height="40dp"
                android:background="@drawable/selector_tv_utility"
                android:clickable="true"
                android:contentDescription="@string/search_v2_voice"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusDown="@id/keyboard"
                android:nextFocusRight="@id/keyword"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="12dp">

                <com.fongmi.android.tv.ui.custom.CustomMic
                    android:id="@+id/mic"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:focusable="false"
                    android:importantForAccessibility="no"
                    android:padding="2dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_search_mic" />

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:includeFontPadding="false"
                    android:text="@string/search_v2_voice_short"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="13sp" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <com.fongmi.android.tv.ui.custom.CustomSearchView
                android:id="@+id/keyword"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@null"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:hint="@string/search_keyword"
                android:imeOptions="actionDone"
                android:inputType="textCapWords|textAutoCorrect|textAutoComplete"
                android:letterSpacing="0.02"
                android:maxLength="255"
                android:nextFocusDown="@id/keyboard"
                android:nextFocusLeft="@id/voiceAction"
                android:singleLine="true"
                android:textColor="@color/tv_text_primary"
                android:textColorHint="@color/tv_text_tertiary"
                android:textCursorDrawable="@drawable/shape_cursor"
                android:textSize="20sp"
                tools:text="漫长的季节" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="@string/search_v2_hint"
                android:textColor="@color/tv_text_tertiary"
                android:textSize="12sp" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="18dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="370dp"
                android:layout_height="match_parent"
                android:background="@drawable/shape_search_v2_panel"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/search_v2_keyboard"
                    android:textColor="@color/tv_text_secondary"
                    android:textSize="@dimen/tv_text_section"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/keyboard"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="10dp"
                    android:layout_weight="1"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    app:spanCount="7"
                    tools:itemCount="42"
                    tools:listitem="@layout/adapter_keyboard_text" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <com.fongmi.android.tv.ui.custom.TouchSafeNestedScrollView
                android:id="@+id/scroll"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="18dp"
                android:layout_weight="1"
                android:background="@drawable/shape_search_v2_panel"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:padding="18dp">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/recordLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="22dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:includeFontPadding="false"
                            android:text="@string/search_record"
                            android:textColor="@color/tv_text_primary"
                            android:textSize="@dimen/tv_text_section"
                            android:textStyle="bold" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recordRecycler"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="-5dp"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:overScrollMode="never"
                            tools:itemCount="6"
                            tools:listitem="@layout/adapter_search_record" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/word"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:includeFontPadding="false"
                        android:text="@string/search_hot"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="@dimen/tv_text_section"
                        android:textStyle="bold" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/wordRecycler"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="-5dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:overScrollMode="never"
                        tools:itemCount="10"
                        tools:listitem="@layout/adapter_search_word" />

                </androidx.appcompat.widget.LinearLayoutCompat>
            </com.fongmi.android.tv.ui.custom.TouchSafeNestedScrollView>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
</FrameLayout>
