<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tv_home_background"
    android:clipChildren="false"
    android:clipToPadding="false">

    <com.fongmi.android.tv.ui.custom.TouchSafeNestedScrollView
        android:id="@+id/settingsScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="48dp"
            android:paddingTop="30dp"
            android:paddingEnd="48dp"
            android:paddingBottom="48dp">

            <com.google.android.material.textview.MaterialTextView
                style="@style/SettingsV2.PageTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_v2_title" />

            <com.google.android.material.textview.MaterialTextView
                style="@style/SettingsV2.PageSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/settings_v2_subtitle" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:baselineAligned="false"
                android:orientation="horizontal"
                tools:ignore="NestedWeights">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1.1"
                    android:background="@drawable/settings_v2_shape_panel"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/SettingsV2.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:layout_marginBottom="10dp"
                        android:text="@string/settings_v2_section_content" />

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:id="@+id/vod"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/settings_v2_selector_row"
                            android:stateListAnimator="@animator/settings_v2_focus_scale"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.textview.MaterialTextView
                                style="@style/SettingsV2.RowLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/setting_vod" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/vodUrl"
                                style="@style/SettingsV2.RowValue"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:ellipsize="middle"
                                android:gravity="end"
                                android:singleLine="true"
                                tools:text="https://example.com/config.json" />
                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/vodHome"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/settings_v2_selector_icon"
                            android:stateListAnimator="@animator/settings_v2_focus_scale"
                            android:contentDescription="@string/settings_v2_source_home"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:src="@drawable/ic_setting_home"
                            android:tint="@color/tv_text_primary" />

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/vodHistory"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/settings_v2_selector_icon"
                            android:stateListAnimator="@animator/settings_v2_focus_scale"
                            android:contentDescription="@string/settings_v2_config_history"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:src="@drawable/ic_setting_history"
                            android:tint="@color/tv_text_primary" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/repository"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/settings_v2_selector_row"
                            android:stateListAnimator="@animator/settings_v2_focus_scale"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/SettingsV2.RowLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_repository" />

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/SettingsV2.RowValue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:gravity="end"
                            android:singleLine="true"
                            android:text="@string/setting_repository_desc" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/cloudAccount"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/settings_v2_selector_row"
                            android:stateListAnimator="@animator/settings_v2_focus_scale"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/SettingsV2.RowLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_cloud_account" />

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/SettingsV2.RowValue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:gravity="end"
                            android:singleLine="true"
                            android:text="@string/setting_cloud_account_desc" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/cloudPriority"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/settings_v2_selector_row"
                            android:stateListAnimator="@animator/settings_v2_focus_scale"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/SettingsV2.RowLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_v2_cloud_priority" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/cloudPriorityText"
                            style="@style/SettingsV2.RowValue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:gravity="end"
                            android:singleLine="true"
                            tools:text="App account first" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:id="@+id/live"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/settings_v2_selector_row"
                            android:stateListAnimator="@animator/settings_v2_focus_scale"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.textview.MaterialTextView
                                style="@style/SettingsV2.RowLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/setting_live" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/liveUrl"
                                style="@style/SettingsV2.RowValue"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:ellipsize="middle"
                                android:gravity="end"
                                android:singleLine="true"
                                tools:text="Live source" />
                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/liveHome"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/settings_v2_selector_icon"
                            android:stateListAnimator="@animator/settings_v2_focus_scale"
                            android:contentDescription="@string/settings_v2_source_home"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:src="@drawable/ic_setting_home"
                            android:tint="@color/tv_text_primary" />

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/liveHistory"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/settings_v2_selector_icon"
                            android:stateListAnimator="@animator/settings_v2_focus_scale"
                            android:contentDescription="@string/settings_v2_config_history"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:src="@drawable/ic_setting_history"
                            android:tint="@color/tv_text_primary" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:id="@+id/wall"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/settings_v2_selector_row"
                            android:stateListAnimator="@animator/settings_v2_focus_scale"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.textview.MaterialTextView
                                style="@style/SettingsV2.RowLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/setting_wall" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/wallUrl"
                                style="@style/SettingsV2.RowValue"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:ellipsize="middle"
                                android:gravity="end"
                                android:singleLine="true"
                                tools:text="Local atmosphere" />
                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/wallDefault"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/settings_v2_selector_icon"
                            android:stateListAnimator="@animator/settings_v2_focus_scale"
                            android:contentDescription="@string/settings_v2_wall_cycle"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:src="@drawable/ic_setting_home"
                            android:tint="@color/tv_text_primary" />

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/wallRefresh"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/settings_v2_selector_icon"
                            android:stateListAnimator="@animator/settings_v2_focus_scale"
                            android:contentDescription="@string/settings_v2_refresh"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:src="@drawable/ic_setting_refresh"
                            android:tint="@color/tv_text_primary" />
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="0.9"
                    android:orientation="vertical">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/settings_v2_shape_panel"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/SettingsV2.SectionTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="2dp"
                            android:layout_marginBottom="10dp"
                            android:text="@string/settings_v2_section_playback" />

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:id="@+id/player"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/settings_v2_selector_row"
                            android:stateListAnimator="@animator/settings_v2_focus_scale"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <com.google.android.material.textview.MaterialTextView
                                style="@style/SettingsV2.RowLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/setting_player" />
                            <com.google.android.material.textview.MaterialTextView
                                style="@style/SettingsV2.RowValue"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:text="@string/settings_v2_open_subpage" />
                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:id="@+id/danmaku"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/settings_v2_selector_row"
                            android:stateListAnimator="@animator/settings_v2_focus_scale"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <com.google.android.material.textview.MaterialTextView
                                style="@style/SettingsV2.RowLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/setting_danmaku" />
                            <com.google.android.material.textview.MaterialTextView
                                style="@style/SettingsV2.RowValue"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:text="@string/settings_v2_open_subpage" />
                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:id="@+id/incognito"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/settings_v2_selector_row"
                            android:stateListAnimator="@animator/settings_v2_focus_scale"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <com.google.android.material.textview.MaterialTextView
                                style="@style/SettingsV2.RowLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/setting_incognito" />
                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/incognitoText"
                                style="@style/SettingsV2.RowValue"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="end"
                                tools:text="Off" />
                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:id="@+id/bootStart"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/settings_v2_selector_row"
                            android:stateListAnimator="@animator/settings_v2_focus_scale"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <com.google.android.material.textview.MaterialTextView
                                style="@style/SettingsV2.RowLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/setting_boot_start" />
                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/bootStartText"
                                style="@style/SettingsV2.RowValue"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="end"
                                tools:text="On" />
                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:id="@+id/size"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/settings_v2_selector_row"
                            android:stateListAnimator="@animator/settings_v2_focus_scale"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <com.google.android.material.textview.MaterialTextView
                                style="@style/SettingsV2.RowLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/setting_size" />
                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/sizeText"
                                style="@style/SettingsV2.RowValue"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="end"
                                tools:text="Medium" />
                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:id="@+id/doh"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/settings_v2_selector_row"
                            android:stateListAnimator="@animator/settings_v2_focus_scale"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <com.google.android.material.textview.MaterialTextView
                                style="@style/SettingsV2.RowLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/setting_doh" />
                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/dohText"
                                style="@style/SettingsV2.RowValue"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="end"
                                tools:text="Google" />
                        </androidx.appcompat.widget.LinearLayoutCompat>
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/settings_v2_shape_panel"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/SettingsV2.SectionTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="2dp"
                            android:layout_marginBottom="10dp"
                            android:text="@string/settings_v2_section_data" />

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <androidx.appcompat.widget.LinearLayoutCompat
                                android:id="@+id/backup"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_marginEnd="4dp"
                                android:layout_weight="1"
                                android:background="@drawable/settings_v2_selector_row"
                            android:stateListAnimator="@animator/settings_v2_focus_scale"
                                android:focusable="true"
                                android:focusableInTouchMode="true"
                                android:gravity="center"
                                android:orientation="horizontal">
                                <com.google.android.material.textview.MaterialTextView
                                    style="@style/SettingsV2.RowLabel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/setting_backup" />
                            </androidx.appcompat.widget.LinearLayoutCompat>
                            <androidx.appcompat.widget.LinearLayoutCompat
                                android:id="@+id/restore"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_marginStart="4dp"
                                android:layout_weight="1"
                                android:background="@drawable/settings_v2_selector_row"
                            android:stateListAnimator="@animator/settings_v2_focus_scale"
                                android:focusable="true"
                                android:focusableInTouchMode="true"
                                android:gravity="center"
                                android:orientation="horizontal">
                                <com.google.android.material.textview.MaterialTextView
                                    style="@style/SettingsV2.RowLabel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/setting_restore" />
                            </androidx.appcompat.widget.LinearLayoutCompat>
                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:id="@+id/cache"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/settings_v2_selector_row"
                            android:stateListAnimator="@animator/settings_v2_focus_scale"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <com.google.android.material.textview.MaterialTextView
                                style="@style/SettingsV2.RowLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/setting_cache" />
                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/cacheText"
                                style="@style/SettingsV2.RowValue"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="end"
                                tools:text="1.0 MB" />
                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:id="@+id/version"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/settings_v2_selector_row"
                            android:stateListAnimator="@animator/settings_v2_focus_scale"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <com.google.android.material.textview.MaterialTextView
                                style="@style/SettingsV2.RowLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/setting_version" />
                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/versionText"
                                style="@style/SettingsV2.RowValue"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="end"
                                tools:text="1.2.1" />
                        </androidx.appcompat.widget.LinearLayoutCompat>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </com.fongmi.android.tv.ui.custom.TouchSafeNestedScrollView>
</FrameLayout>
