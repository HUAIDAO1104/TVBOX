<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- One predictable remote-control row.  Focus neighbours are also rebuilt at runtime so
         optional subtitle/audio/danmaku actions can disappear without leaving a dead target. -->
    <HorizontalScrollView
        android:id="@+id/primaryScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:focusable="false"
        android:overScrollMode="never"
        android:scrollbars="none">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/primaryRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/next"
                style="@style/PlayerV2.Control.Primary"
                android:layout_marginEnd="9dp"
                android:nextFocusLeft="@id/next"
                android:nextFocusUp="@id/next"
                android:nextFocusDown="@id/next"
                android:text="@string/play_next" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/episodes"
                style="@style/PlayerV2.Control"
                android:layout_marginEnd="9dp"
                android:nextFocusUp="@id/episodes"
                android:nextFocusDown="@id/episodes"
                android:text="@string/episode_picker_action"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Touch-only playback actions. They remain gone for the TV flavour and are enabled
                 at runtime for the mobile flavour, which shares this landscape presentation. -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/playPause"
                style="@style/PlayerV2.Control"
                android:layout_marginEnd="9dp"
                android:drawableStart="@drawable/player_v2_ic_pause"
                android:nextFocusUp="@id/playPause"
                android:nextFocusDown="@id/playPause"
                android:text="@string/pause"
                android:visibility="gone" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/rewind"
                style="@style/PlayerV2.Control"
                android:layout_marginEnd="9dp"
                android:drawableStart="@drawable/player_v2_ic_rewind"
                android:nextFocusUp="@id/rewind"
                android:nextFocusDown="@id/rewind"
                android:text="@string/player_v2_rewind"
                android:visibility="gone" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/forward"
                style="@style/PlayerV2.Control"
                android:layout_marginEnd="9dp"
                android:drawableStart="@drawable/player_v2_ic_forward"
                android:nextFocusUp="@id/forward"
                android:nextFocusDown="@id/forward"
                android:text="@string/player_v2_forward"
                android:visibility="gone" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/audio"
                style="@style/PlayerV2.Control"
                android:layout_marginEnd="9dp"
                android:nextFocusUp="@id/audio"
                android:nextFocusDown="@id/audio"
                android:tag="1"
                android:text="@string/play_track_audio" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/danmaku"
                style="@style/PlayerV2.Control"
                android:layout_marginEnd="9dp"
                android:nextFocusUp="@id/danmaku"
                android:nextFocusDown="@id/danmaku"
                android:saveEnabled="false"
                android:text="@string/danmaku"
                android:visibility="gone"
                tools:visibility="visible" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/danmakuSetting"
                style="@style/PlayerV2.Control"
                android:layout_marginEnd="9dp"
                android:nextFocusUp="@id/danmakuSetting"
                android:nextFocusDown="@id/danmakuSetting"
                android:text="@string/danmaku_setting"
                android:visibility="gone"
                tools:visibility="visible" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/prev"
                style="@style/PlayerV2.Control"
                android:layout_marginEnd="9dp"
                android:nextFocusUp="@id/prev"
                android:nextFocusDown="@id/prev"
                android:text="@string/play_prev"
                android:visibility="gone" />

            <com.fongmi.android.tv.ui.custom.CustomUpDownView
                android:id="@+id/speed"
                style="@style/PlayerV2.Control"
                android:layout_marginEnd="9dp"
                android:fontFeatureSettings="tnum"
                android:nextFocusUp="@id/speed"
                android:nextFocusDown="@id/speed"
                android:text="@string/play_speed" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/scale"
                style="@style/PlayerV2.Control"
                android:layout_marginEnd="9dp"
                android:nextFocusUp="@id/scale"
                android:nextFocusDown="@id/scale"
                android:text="@string/play_scale" />

            <com.fongmi.android.tv.ui.custom.CustomUpDownView
                android:id="@+id/text"
                style="@style/PlayerV2.Control"
                android:layout_marginEnd="9dp"
                android:nextFocusUp="@id/text"
                android:nextFocusDown="@id/text"
                android:tag="3"
                android:text="@string/play_track_text" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/player"
                style="@style/PlayerV2.Control"
                android:nextFocusUp="@id/player"
                android:nextFocusDown="@id/player"
                android:nextFocusRight="@id/player"
                android:text="@string/play_exo" />

        </androidx.appcompat.widget.LinearLayoutCompat>
    </HorizontalScrollView>

    <!-- Retain non-visual bindings used by shared playback state code.  These legacy actions are
         intentionally outside the remote focus graph and never occupy controller space. -->
    <FrameLayout
        android:id="@+id/legacyActions"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:focusable="false"
        android:importantForAccessibility="noHideDescendants"
        android:visibility="gone">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/repeat"
            android:layout_width="0dp"
            android:layout_height="0dp" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/decode"
            android:layout_width="0dp"
            android:layout_height="0dp" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/parse"
            android:layout_width="0dp"
            android:layout_height="0dp" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/video"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:tag="2" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/reset"
            android:layout_width="0dp"
            android:layout_height="0dp" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/replay"
            android:layout_width="0dp"
            android:layout_height="0dp" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/edition"
            android:layout_width="0dp"
            android:layout_height="0dp" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/chapter"
            android:layout_width="0dp"
            android:layout_height="0dp" />

        <com.fongmi.android.tv.ui.custom.CustomUpDownView
            android:id="@+id/opening"
            android:layout_width="0dp"
            android:layout_height="0dp" />

        <com.fongmi.android.tv.ui.custom.CustomUpDownView
            android:id="@+id/ending"
            android:layout_width="0dp"
            android:layout_height="0dp" />

    </FrameLayout>

</FrameLayout>
