<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:background="@drawable/player_v2_controller_background"
    android:orientation="vertical"
    android:paddingStart="56dp"
    android:paddingTop="32dp"
    android:paddingEnd="56dp"
    android:paddingBottom="22dp">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/controlTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/tv_text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="灿如繁星：第8集" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/controlStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:textColor="@color/tv_text_secondary"
            android:textSize="13sp"
            tools:text="当前线路 · 示例来源" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.media3.ui.PlayerSeekView
        android:id="@+id/seek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp" />

    <include
        android:id="@+id/action"
        layout="@layout/view_control_vod_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</androidx.appcompat.widget.LinearLayoutCompat>
