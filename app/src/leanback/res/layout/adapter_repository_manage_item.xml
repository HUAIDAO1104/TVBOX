<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="94dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <androidx.appcompat.widget.LinearLayoutCompat android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="12dp" android:layout_weight="1" android:background="@drawable/selector_tv_surface" android:gravity="center_vertical" android:orientation="vertical" android:paddingHorizontal="16dp">
        <androidx.appcompat.widget.LinearLayoutCompat android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:id="@+id/name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:singleLine="true" android:textColor="@color/white" android:textSize="17sp" android:textStyle="bold" />
            <TextView android:id="@+id/type" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/white_60" android:textSize="13sp" />
        </androidx.appcompat.widget.LinearLayoutCompat>
        <TextView android:id="@+id/url" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:ellipsize="middle" android:singleLine="true" android:textColor="@color/white_40" android:textSize="12sp" />
        <TextView android:id="@+id/check_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:ellipsize="end" android:singleLine="true" android:textColor="@color/white_60" android:textSize="12sp" />
    </androidx.appcompat.widget.LinearLayoutCompat>

    <TextView android:id="@+id/enable" android:layout_width="70dp" android:layout_height="40dp" android:background="@drawable/selector_tv_button" android:focusable="true" android:gravity="center" android:textColor="@color/tv_button_text" />
    <TextView android:id="@+id/check" android:layout_width="70dp" android:layout_height="40dp" android:layout_marginStart="8dp" android:background="@drawable/selector_tv_button" android:focusable="true" android:gravity="center" android:text="@string/repository_check" android:textColor="@color/tv_button_text" />
    <androidx.appcompat.widget.AppCompatImageView android:id="@+id/up" android:layout_width="48dp" android:layout_height="40dp" android:layout_marginStart="8dp" android:background="@drawable/selector_tv_button" android:contentDescription="@string/repository_move_up" android:focusable="true" android:padding="10dp" android:src="@drawable/ic_subtitle_up" />
    <androidx.appcompat.widget.AppCompatImageView android:id="@+id/down" android:layout_width="48dp" android:layout_height="40dp" android:layout_marginStart="8dp" android:background="@drawable/selector_tv_button" android:contentDescription="@string/repository_move_down" android:focusable="true" android:padding="10dp" android:src="@drawable/ic_subtitle_down" />
    <TextView android:id="@+id/use" android:layout_width="84dp" android:layout_height="40dp" android:layout_marginStart="8dp" android:background="@drawable/selector_tv_button_primary" android:focusable="true" android:gravity="center" android:text="@string/repository_use" android:textColor="@color/tv_button_text" />
    <TextView android:id="@+id/delete" android:layout_width="70dp" android:layout_height="40dp" android:layout_marginStart="8dp" android:background="@drawable/selector_tv_button" android:focusable="true" android:gravity="center" android:text="@string/repository_delete" android:textColor="@color/tv_button_text" />
</androidx.appcompat.widget.LinearLayoutCompat>
