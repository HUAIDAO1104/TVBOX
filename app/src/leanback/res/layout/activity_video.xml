<?xml version="1.0" encoding="utf-8"?>
<com.fongmi.android.tv.ui.custom.ProgressLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/progressLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tv_background"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Kept as binding anchors for fullscreen transitions; detail mode intentionally has no
         poster-derived page background. -->
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/detailBackdrop"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <View
        android:id="@+id/detailVignette"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <com.fongmi.android.tv.ui.custom.TouchSafeNestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:fadeScrollbars="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/detailHero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="@dimen/detail_v2_safe_start"
            android:paddingTop="12dp"
            android:paddingEnd="@dimen/detail_v2_safe_end"
            android:paddingBottom="32dp">

            <!-- Compact 30/70 TV split: the left preview stays fixed while the right content scrolls. -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/detailStageRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="top"
                android:orientation="horizontal">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/detailLeftColumn"
                    android:layout_width="@dimen/detail_v2_left_width"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="14dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical">

                    <!-- The real player remains a root child so fullscreen changes stay reliable. -->
                    <Space
                        android:id="@+id/detailPosterReserve"
                        android:layout_width="@dimen/detail_v2_preview_width"
                        android:layout_height="@dimen/detail_v2_preview_height"
                        android:importantForAccessibility="no" />

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/detailCopy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/detail_v2_info_card"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:elevation="1dp"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top"
                            android:orientation="horizontal">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/detailPoster"
                                android:layout_width="@dimen/detail_v2_info_poster_width"
                                android:layout_height="@dimen/detail_v2_info_poster_height"
                                android:layout_marginEnd="10dp"
                                android:background="@android:color/transparent"
                                android:contentDescription="@string/home_featured_poster"
                                android:scaleType="centerCrop"
                                app:shapeAppearanceOverlay="@style/Tv.Poster"
                                app:strokeColor="#38FFFFFF"
                                app:strokeWidth="1dp" />

                            <androidx.appcompat.widget.LinearLayoutCompat
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <com.google.android.material.textview.MaterialTextView
                                    android:id="@+id/name"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:lineSpacingExtra="1dp"
                                    android:maxLines="2"
                                    android:textColor="@color/tv_text_primary"
                                    android:textSize="15sp"
                                    android:textStyle="bold"
                                    tools:text="庆余年 第二季" />

                                <com.google.android.material.textview.MaterialTextView
                                    android:id="@+id/remark"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:ellipsize="end"
                                    android:maxLines="2"
                                    android:textColor="@color/tv_text_secondary"
                                    android:textSize="11sp"
                                    tools:text="2024 · 中国大陆 · 剧情 / 古装 · 36 集全" />

                                <androidx.appcompat.widget.LinearLayoutCompat
                                    android:id="@+id/row1"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:orientation="horizontal">

                                    <com.google.android.material.textview.MaterialTextView
                                        android:id="@+id/site"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textColor="@color/tv_text_tertiary"
                                        android:textSize="10sp"
                                        tools:text="来源 · 玩偶" />

                                    <com.google.android.material.textview.MaterialTextView
                                        android:id="@+id/year"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:visibility="gone" />

                                    <com.google.android.material.textview.MaterialTextView
                                        android:id="@+id/area"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:visibility="gone" />

                                    <com.google.android.material.textview.MaterialTextView
                                        android:id="@+id/type"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:visibility="gone" />
                                </androidx.appcompat.widget.LinearLayoutCompat>

                                <com.google.android.material.textview.MaterialTextView
                                    android:id="@+id/director"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5dp"
                                    android:ellipsize="end"
                                    android:maxLines="2"
                                    android:textColor="@color/tv_text_tertiary"
                                    android:textSize="10sp"
                                    tools:text="导演：孙皓" />

                                <com.google.android.material.textview.MaterialTextView
                                    android:id="@+id/actor"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:ellipsize="end"
                                    android:maxLines="2"
                                    android:textColor="@color/tv_text_tertiary"
                                    android:textSize="10sp"
                                    tools:text="演员：张若昀、李沁、陈道明" />
                            </androidx.appcompat.widget.LinearLayoutCompat>
                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/summary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:ellipsize="end"
                            android:lineSpacingExtra="1dp"
                            android:maxLines="3"
                            android:textColor="@color/tv_text_secondary"
                            android:textSize="11sp"
                            tools:text="范闲归京后卷入新的朝堂纷争，在复杂局势中继续追寻身世真相。" />

                        <!-- Legacy action anchors remain for controller binding but are not part of
                             the redesigned visual flow; OK on the video surface starts playback. -->
                        <com.google.android.flexbox.FlexboxLayout
                            android:id="@+id/row2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone">

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/primary"
                                style="@style/DetailV2.Button.Primary"
                                android:text="@string/detail_v2_play_now" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/episodeAction"
                                style="@style/DetailV2.Button.Secondary"
                                android:text="@string/detail_v2_choose_episode" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/keep"
                                style="@style/DetailV2.Button.Secondary"
                                android:text="@string/keep" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/content"
                                style="@style/DetailV2.Button.Link"
                                android:text="@string/detail_v2_full_summary" />
                        </com.google.android.flexbox.FlexboxLayout>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/sourceHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="5dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/sourceTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/detail_v2_source"
                            android:textColor="@color/tv_text_primary"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/change"
                            style="@style/DetailV2.Button.Link"
                            android:drawableStart="@drawable/ic_detail_change"
                            android:minWidth="70dp"
                            android:minHeight="32dp"
                            android:nextFocusDown="@id/flag"
                            android:text="@string/play_change" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.leanback.widget.HorizontalGridView
                        android:id="@+id/flag"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginBottom="7dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/qualityTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="5dp"
                        android:text="@string/detail_v2_quality"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <androidx.leanback.widget.HorizontalGridView
                        android:id="@+id/quality"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="10dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:visibility="gone" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/episodeTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="@string/detail_v2_episode_list"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/episode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <androidx.leanback.widget.HorizontalGridView
                        android:id="@+id/array"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginBottom="8dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:visibility="gone" />

                    <androidx.leanback.widget.HorizontalGridView
                        android:id="@+id/part"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginBottom="8dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:visibility="gone" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/quickTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="5dp"
                        android:text="@string/detail_v2_more_sources"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <androidx.leanback.widget.HorizontalGridView
                        android:id="@+id/quick"
                        android:layout_width="match_parent"
                        android:layout_height="106dp"
                        android:layout_marginBottom="8dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:visibility="gone" />
                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </com.fongmi.android.tv.ui.custom.TouchSafeNestedScrollView>

    <!-- Direct root child: detail position is 16:9; fullscreen swaps only these layout params. -->
    <FrameLayout
        android:id="@+id/video"
        android:layout_width="@dimen/detail_v2_preview_width"
        android:layout_height="@dimen/detail_v2_preview_height"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="@dimen/detail_v2_safe_start"
        android:layout_marginTop="12dp"
        android:background="@color/black"
        android:clipToOutline="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:foreground="@drawable/selector_video"
        android:nextFocusLeft="@id/video"
        android:nextFocusRight="@id/flag"
        android:nextFocusUp="@id/video"
        android:nextFocusDown="@id/flag">

        <FrameLayout
            android:id="@+id/detailPreviewGroup"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/detailPreviewBackdrop"
                android:layout_width="1dp"
                android:layout_height="1dp" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/detailPreview"
                android:layout_width="1dp"
                android:layout_height="1dp" />
        </FrameLayout>

        <androidx.media3.ui.PlayerView
            android:id="@+id/player"
            style="@style/Player.Vod"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/black"
            app:shutter_background_color="@color/black"
            app:surface_type="none" />

        <include
            android:id="@+id/widget"
            layout="@layout/view_widget_vod"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            android:id="@+id/control"
            layout="@layout/view_control_vod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:visibility="gone" />

        <include
            android:id="@+id/progress"
            layout="@layout/player_v2_progress"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

</com.fongmi.android.tv.ui.custom.ProgressLayout>
