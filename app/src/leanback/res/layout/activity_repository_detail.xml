<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tv_home_background"
    android:orientation="vertical"
    android:paddingStart="54dp"
    android:paddingTop="30dp"
    android:paddingEnd="54dp"
    android:paddingBottom="30dp">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/white" android:textSize="28sp" android:textStyle="bold" />
            <TextView android:id="@+id/url" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:ellipsize="middle" android:singleLine="true" android:textColor="@color/white_60" android:textSize="14sp" />
            <TextView android:id="@+id/meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/white_60" android:textSize="14sp" />
            <TextView android:id="@+id/flags" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/white_60" android:textSize="13sp" />
            <TextView android:id="@+id/sync_info" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:ellipsize="end" android:maxLines="2" android:textColor="@color/white_40" android:textSize="12sp" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <TextView android:id="@+id/type" android:layout_width="wrap_content" android:layout_height="40dp" android:gravity="center" android:paddingHorizontal="14dp" android:textColor="@color/white_60" />
        <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="40dp" android:gravity="center" android:paddingHorizontal="14dp" android:textColor="@color/white" />
        <TextView android:id="@+id/cache" android:layout_width="wrap_content" android:layout_height="40dp" android:gravity="center" android:paddingHorizontal="14dp" android:textColor="@color/white_60" />
        <TextView android:id="@+id/refresh" android:layout_width="96dp" android:layout_height="42dp" android:background="@drawable/selector_tv_button" android:focusable="true" android:gravity="center" android:text="@string/repository_refresh" android:textColor="@color/tv_button_text" />
    </androidx.appcompat.widget.LinearLayoutCompat>

    <TextView android:id="@+id/error" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/selector_tv_surface" android:maxLines="2" android:padding="12dp" android:textColor="@color/tv_error" android:textSize="14sp" android:visibility="gone" />
    <TextView android:id="@+id/empty" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="70dp" android:text="@string/repository_item_empty" android:textColor="@color/white_60" android:visibility="gone" />

    <com.fongmi.android.tv.ui.custom.CustomRecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="18dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:overScrollMode="never"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
</androidx.appcompat.widget.LinearLayoutCompat>
