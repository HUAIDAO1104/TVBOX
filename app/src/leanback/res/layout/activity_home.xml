<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tv_home_background"
    android:clipChildren="false"
    android:clipToPadding="false">

    <View
        android:id="@+id/atmosphere"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <View
        android:id="@+id/atmosphereGlow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/tv_home_scrim"
        android:importantForAccessibility="no" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/tv_home_vignette"
        android:importantForAccessibility="no" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/topNavigation"
            android:layout_width="match_parent"
            android:layout_height="@dimen/home_top_height"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/home_safe_start"
            android:paddingEnd="@dimen/home_safe_end">

            <androidx.leanback.widget.HorizontalGridView
                android:id="@+id/nav"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:overScrollMode="never"
                app:focusOutEnd="true"
                app:focusOutFront="false" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/search"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/selector_tv_utility"
                android:contentDescription="@string/home_search"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusDown="@id/play"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_home_toolbar_search"
                android:translationY="-6dp" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/config"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/selector_tv_utility"
                android:contentDescription="@string/home_config"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusDown="@id/play"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_home_toolbar_config"
                android:translationY="-6dp" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/settings"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/selector_tv_utility"
                android:contentDescription="@string/home_setting"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusDown="@id/play"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_home_toolbar_settings"
                android:translationY="-6dp" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.fongmi.android.tv.ui.custom.TouchSafeNestedScrollView
                android:id="@+id/homeScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:overScrollMode="never">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical"
                    android:paddingBottom="12dp">

                    <FrameLayout
                        android:id="@+id/heroStage"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/home_featured_height"
                        android:clipChildren="false"
                        android:clipToPadding="false">

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:layout_width="@dimen/home_featured_left_width"
                            android:layout_height="match_parent"
                            android:layout_marginStart="@dimen/home_safe_start"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:orientation="vertical"
                            android:paddingTop="8dp">

                            <androidx.appcompat.widget.LinearLayoutCompat
                                android:id="@+id/featuredInfo"
                                android:layout_width="@dimen/home_featured_copy_width"
                                android:layout_height="174dp"
                                android:clipChildren="false"
                                android:clipToPadding="false"
                                android:orientation="vertical">

                                <com.google.android.material.textview.MaterialTextView
                                    android:id="@+id/featuredName"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:includeFontPadding="false"
                                    android:maxLines="1"
                                    android:textColor="@color/tv_text_primary"
                                    android:textSize="@dimen/tv_text_featured"
                                    android:textStyle="bold"
                                    tools:text="漫长的季节" />

                                <androidx.appcompat.widget.LinearLayoutCompat
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <com.google.android.material.textview.MaterialTextView
                                        android:id="@+id/featuredMeta"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:ellipsize="end"
                                        android:includeFontPadding="false"
                                        android:maxWidth="360dp"
                                        android:singleLine="true"
                                        android:textColor="@color/tv_text_secondary"
                                        android:textSize="@dimen/tv_text_meta"
                                        tools:text="2023 · 中国大陆 · 剧情 / 家庭 / 悬疑" />

                                    <com.google.android.material.textview.MaterialTextView
                                        android:id="@+id/featuredScore"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="10dp"
                                        android:background="@drawable/shape_tv_score_badge"
                                        android:includeFontPadding="false"
                                        android:singleLine="true"
                                        android:textColor="@color/tv_success"
                                        android:textSize="12sp"
                                        android:textStyle="bold"
                                        android:visibility="gone"
                                        tools:text="豆瓣 9.4"
                                        tools:visibility="visible" />

                                </androidx.appcompat.widget.LinearLayoutCompat>

                                <com.google.android.material.textview.MaterialTextView
                                    android:id="@+id/featuredRemark"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:ellipsize="end"
                                    android:includeFontPadding="false"
                                    android:singleLine="true"
                                    android:textColor="@color/tv_text_secondary"
                                    android:textSize="13sp"
                                    android:visibility="gone"
                                    tools:text="全 12 集"
                                    tools:visibility="visible" />

                                <com.google.android.material.textview.MaterialTextView
                                    android:id="@+id/featuredSummary"
                                    android:layout_width="430dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="7dp"
                                    android:ellipsize="end"
                                    android:includeFontPadding="false"
                                    android:lineSpacingExtra="2dp"
                                    android:maxLines="2"
                                    android:textColor="@color/tv_text_secondary"
                                    android:textSize="@dimen/tv_text_body"
                                    tools:text="一起横跨二十年的碎尸案，牵扯出几个家庭命运的变迁。隐藏在时光深处的秘密与真相逐渐浮现。" />

                                <Space
                                    android:layout_width="1dp"
                                    android:layout_height="0dp"
                                    android:layout_weight="1" />

                                <androidx.appcompat.widget.LinearLayoutCompat
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:clipChildren="false"
                                    android:clipToPadding="false"
                                    android:orientation="horizontal">

                                    <com.google.android.material.button.MaterialButton
                                        android:id="@+id/play"
                                        android:layout_width="138dp"
                                        android:layout_height="38dp"
                                        android:background="@drawable/selector_tv_button_primary"
                                        android:elevation="3dp"
                                        android:focusable="true"
                                        android:focusableInTouchMode="true"
                                        android:gravity="center"
                                        android:includeFontPadding="false"
                                        android:insetBottom="0dp"
                                        android:insetLeft="0dp"
                                        android:insetRight="0dp"
                                        android:insetTop="0dp"
                                        android:minWidth="0dp"
                                        android:minHeight="0dp"
                                        android:nextFocusDown="@id/historyRecycler"
                                        android:paddingStart="15dp"
                                        android:paddingTop="0dp"
                                        android:paddingEnd="15dp"
                                        android:paddingBottom="0dp"
                                        android:stateListAnimator="@null"
                                        android:text="@string/home_play_now"
                                        android:textAllCaps="false"
                                        android:textColor="@color/tv_button_text"
                                        android:textSize="15sp"
                                        android:textStyle="bold"
                                        app:backgroundTint="@null"
                                        app:icon="@drawable/ic_widget_play"
                                        app:iconGravity="textStart"
                                        app:iconPadding="7dp"
                                        app:iconSize="14dp"
                                        app:iconTint="@color/tv_text_primary"
                                        />

                                    <com.google.android.material.button.MaterialButton
                                        android:id="@+id/detail"
                                        android:layout_width="116dp"
                                        android:layout_height="38dp"
                                        android:layout_marginStart="14dp"
                                        android:background="@drawable/selector_tv_button"
                                        android:focusable="true"
                                        android:focusableInTouchMode="true"
                                        android:gravity="center"
                                        android:includeFontPadding="false"
                                        android:insetBottom="0dp"
                                        android:insetLeft="0dp"
                                        android:insetRight="0dp"
                                        android:insetTop="0dp"
                                        android:minWidth="0dp"
                                        android:minHeight="0dp"
                                        android:nextFocusRight="@id/featuredIndicator"
                                        android:nextFocusDown="@id/historyRecycler"
                                        android:paddingStart="14dp"
                                        android:paddingTop="0dp"
                                        android:paddingEnd="14dp"
                                        android:paddingBottom="0dp"
                                        android:stateListAnimator="@null"
                                        android:text="@string/home_view_detail"
                                        android:textAllCaps="false"
                                        android:textColor="@color/tv_button_text"
                                        android:textSize="15sp"
                                        android:textStyle="bold"
                                        app:backgroundTint="@null"
                                        />

                                </androidx.appcompat.widget.LinearLayoutCompat>

                            </androidx.appcompat.widget.LinearLayoutCompat>

                            <Space
                                android:layout_width="1dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <androidx.appcompat.widget.LinearLayoutCompat
                                android:id="@+id/historySection"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:orientation="vertical">

                                <androidx.appcompat.widget.LinearLayoutCompat
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <com.google.android.material.textview.MaterialTextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:includeFontPadding="false"
                                        android:text="@string/home_continue_watching"
                                        android:textColor="@color/tv_text_primary"
                                        android:textSize="@dimen/tv_text_section"
                                        android:textStyle="bold" />

                                    <com.google.android.material.textview.MaterialTextView
                                        android:id="@+id/historyMore"
                                        style="@style/DetailV2.Button.Link"
                                        android:layout_marginEnd="10dp"
                                        android:drawableEnd="@drawable/ic_keyboard_right"
                                        android:nextFocusDown="@id/historyRecycler"
                                        android:text="@string/home_view_all" />

                                </androidx.appcompat.widget.LinearLayoutCompat>

                                <androidx.leanback.widget.HorizontalGridView
                                    android:id="@+id/historyRecycler"
                                    android:layout_width="match_parent"
                                    android:layout_height="64dp"
                                    android:layout_marginTop="5dp"
                                    android:clipChildren="false"
                                    android:clipToPadding="false"
                                    android:overScrollMode="never"
                                    app:focusOutEnd="true"
                                    app:focusOutFront="true" />

                            </androidx.appcompat.widget.LinearLayoutCompat>

                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <com.fongmi.android.tv.ui.home.HomePosterAuraView
                            android:id="@+id/featuredPosterAura"
                            android:layout_width="390dp"
                            android:layout_height="@dimen/home_featured_height"
                            android:layout_gravity="center_vertical|end"
                            android:layout_marginEnd="2dp"
                            android:alpha="0"
                            android:importantForAccessibility="no"
                            android:scaleType="centerCrop"
                            android:visibility="gone" />

                        <FrameLayout
                            android:layout_width="@dimen/home_featured_poster_frame_width"
                            android:layout_height="@dimen/home_featured_poster_frame_height"
                            android:layout_gravity="center_vertical|end"
                            android:layout_marginEnd="@dimen/home_featured_poster_end"
                            android:background="@drawable/shape_tv_featured_poster_shadow"
                            android:clipToOutline="true"
                            android:elevation="18dp"
                            android:outlineAmbientShadowColor="#99000000"
                            android:outlineProvider="background"
                            android:outlineSpotShadowColor="#E0000000">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/featuredPoster"
                                android:layout_width="@dimen/home_featured_poster_width"
                                android:layout_height="@dimen/home_featured_poster_height"
                                android:layout_gravity="center"
                                android:background="@android:color/transparent"
                                android:contentDescription="@string/home_featured_poster"
                                android:scaleType="centerCrop"
                                app:shapeAppearanceOverlay="@style/Tv.Poster.Small" />

                        </FrameLayout>

                        <com.fongmi.android.tv.ui.home.HomeCarouselIndicatorView
                            android:id="@+id/featuredIndicator"
                            android:layout_width="100dp"
                            android:layout_height="20dp"
                            android:layout_gravity="bottom|end"
                            android:layout_marginEnd="154dp"
                            android:alpha="0.78"
                            android:nextFocusLeft="@id/detail"
                            android:nextFocusUp="@id/detail"
                            android:nextFocusDown="@id/historyRecycler"
                            android:translationY="7dp" />

                    </FrameLayout>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/recommendSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/home_safe_start"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="@dimen/home_safe_end"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clipChildren="false"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:includeFontPadding="false"
                                android:text="@string/home_hot_recommend"
                                android:textColor="@color/tv_text_primary"
                                android:textSize="@dimen/tv_text_section"
                                android:textStyle="bold" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/recommendMore"
                                android:layout_width="74dp"
                                android:layout_height="32dp"
                                android:background="@drawable/selector_tv_button"
                                android:focusable="true"
                                android:focusableInTouchMode="true"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:insetBottom="0dp"
                                android:insetLeft="0dp"
                                android:insetRight="0dp"
                                android:insetTop="0dp"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:nextFocusDown="@id/recommendRecycler"
                                android:padding="0dp"
                                android:stateListAnimator="@null"
                                android:text="@string/home_more"
                                android:textAllCaps="false"
                                android:textColor="@color/tv_button_text"
                                android:textSize="13sp"
                                app:backgroundTint="@null" />

                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <androidx.leanback.widget.HorizontalGridView
                            android:id="@+id/recommendRecycler"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/home_poster_row_height"
                            android:layout_marginTop="4dp"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:overScrollMode="never"
                            android:paddingTop="@dimen/home_poster_focus_inset"
                            android:paddingBottom="@dimen/home_poster_focus_inset"
                            app:focusOutEnd="true"
                            app:focusOutFront="true" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                </androidx.appcompat.widget.LinearLayoutCompat>
            </com.fongmi.android.tv.ui.custom.TouchSafeNestedScrollView>

            <FrameLayout
                android:id="@+id/categoryContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/loadingState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/home_featured_height">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="420dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/home_safe_start"
                        android:layout_marginTop="34dp"
                        android:orientation="vertical">

                        <View
                            android:layout_width="270dp"
                            android:layout_height="42dp"
                            android:background="@drawable/shape_tv_skeleton" />

                        <View
                            android:layout_width="330dp"
                            android:layout_height="15dp"
                            android:layout_marginTop="16dp"
                            android:background="@drawable/shape_tv_skeleton" />

                        <View
                            android:layout_width="410dp"
                            android:layout_height="48dp"
                            android:layout_marginTop="14dp"
                            android:background="@drawable/shape_tv_skeleton" />

                        <View
                            android:layout_width="280dp"
                            android:layout_height="40dp"
                            android:layout_marginTop="14dp"
                            android:background="@drawable/shape_tv_skeleton" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="570dp"
                        android:layout_height="70dp"
                        android:layout_gravity="bottom|start"
                        android:layout_marginStart="@dimen/home_safe_start"
                        android:layout_marginBottom="4dp"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="178dp"
                            android:layout_height="70dp"
                            android:background="@drawable/shape_tv_skeleton" />

                        <View
                            android:layout_width="178dp"
                            android:layout_height="70dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/shape_tv_skeleton" />

                        <View
                            android:layout_width="178dp"
                            android:layout_height="70dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/shape_tv_skeleton" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <View
                        android:layout_width="@dimen/home_featured_poster_frame_width"
                        android:layout_height="@dimen/home_featured_poster_frame_height"
                        android:layout_gravity="top|end"
                        android:layout_marginEnd="@dimen/home_featured_poster_end"
                        android:background="@drawable/shape_tv_skeleton" />

                </FrameLayout>

                <View
                    android:layout_width="112dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="@dimen/home_safe_start"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/shape_tv_skeleton" />

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="132dp"
                    android:layout_marginStart="@dimen/home_safe_start"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="100dp"
                        android:layout_height="132dp"
                        android:background="@drawable/shape_tv_skeleton" />

                    <View
                        android:layout_width="100dp"
                        android:layout_height="132dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/shape_tv_skeleton" />

                    <View
                        android:layout_width="100dp"
                        android:layout_height="132dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/shape_tv_skeleton" />

                    <View
                        android:layout_width="100dp"
                        android:layout_height="132dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/shape_tv_skeleton" />

                </androidx.appcompat.widget.LinearLayoutCompat>

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/emptyState"
                android:layout_width="420dp"
                android:layout_height="220dp"
                android:layout_gravity="center"
                android:background="@drawable/shape_tv_surface"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/home_empty_message"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="@dimen/tv_text_section" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/emptyConfig"
                    android:layout_width="140dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/selector_tv_button_primary"
                    android:focusable="true"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="@string/home_switch_config"
                    android:textAllCaps="false"
                    android:textColor="@color/tv_button_text"
                    app:backgroundTint="@null"
                    />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/errorState"
                android:layout_width="480dp"
                android:layout_height="260dp"
                android:layout_gravity="center"
                android:background="@drawable/shape_tv_surface"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="@string/home_error_message"
                    android:src="@drawable/ic_widget_error" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/errorMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:maxWidth="400dp"
                    android:text="@string/home_error_message"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="@dimen/tv_text_section" />

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/retry"
                        android:layout_width="112dp"
                        android:layout_height="40dp"
                        android:background="@drawable/selector_tv_button_primary"
                        android:focusable="true"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:text="@string/home_retry"
                        android:textAllCaps="false"
                        android:textColor="@color/tv_button_text"
                        app:backgroundTint="@null"
                        />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/errorConfig"
                        android:layout_width="112dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/selector_tv_button"
                        android:focusable="true"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:text="@string/home_switch_config"
                        android:textAllCaps="false"
                        android:textColor="@color/tv_button_text"
                        app:backgroundTint="@null"
                        />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/errorSettings"
                        android:layout_width="112dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/selector_tv_button"
                        android:focusable="true"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:text="@string/home_setting"
                        android:textAllCaps="false"
                        android:textColor="@color/tv_button_text"
                        app:backgroundTint="@null"
                        />

                </androidx.appcompat.widget.LinearLayoutCompat>

            </androidx.appcompat.widget.LinearLayoutCompat>

        </FrameLayout>

    </androidx.appcompat.widget.LinearLayoutCompat>

    <!-- In-app launch veil lets cache/config/home work continue behind a deterministic branded
         animation instead of holding the system splash on network work. -->
    <FrameLayout
        android:id="@+id/brandSplash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/settings_v2_brand_background"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:importantForAccessibility="noHideDescendants">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/brandSplashBackdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/pdd_splash_background_v2" />

        <View
            android:id="@+id/brandSplashSweep"
            android:layout_width="420dp"
            android:layout_height="2dp"
            android:layout_gravity="center"
            android:alpha="0"
            android:background="@drawable/brand_splash_sweep"
            android:importantForAccessibility="no"
            android:rotation="-11"
            android:translationY="-18dp" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:translationY="-4dp">

            <FrameLayout
                android:layout_width="190dp"
                android:layout_height="164dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <View
                    android:id="@+id/brandSplashHalo"
                    android:layout_width="184dp"
                    android:layout_height="184dp"
                    android:layout_gravity="center"
                    android:alpha="0"
                    android:background="@drawable/brand_splash_halo"
                    android:importantForAccessibility="no" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/brandSplashFrameLeft"
                    android:layout_width="126dp"
                    android:layout_height="126dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/brand_icon_master" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/brandSplashFrameRight"
                    android:layout_width="126dp"
                    android:layout_height="126dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/brand_icon_master" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/brandSplashPlay"
                    android:layout_width="138dp"
                    android:layout_height="138dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/app_name"
                    android:elevation="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/brand_icon_master" />

            </FrameLayout>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/brandSplashTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:includeFontPadding="false"
                android:letterSpacing="0.15"
                android:text="@string/app_name"
                android:textColor="@color/tv_text_primary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/brandSplashTagline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:includeFontPadding="false"
                android:letterSpacing="0.1"
                android:text="@string/brand_tagline"
                android:textColor="#B8FFFFFF"
                android:textSize="13sp" />

            <View
                android:id="@+id/brandSplashPulse"
                android:layout_width="96dp"
                android:layout_height="2dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/brand_splash_sweep" />

        </androidx.appcompat.widget.LinearLayoutCompat>

    </FrameLayout>

</FrameLayout>
