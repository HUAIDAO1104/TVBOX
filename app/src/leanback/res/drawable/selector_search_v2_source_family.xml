<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true" android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#4D4B3424" />
            <corners android:radius="10dp" />
            <stroke android:width="2dp" android:color="@color/tv_focus_border" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#303B2C22" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#B3FFBB82" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#2EFFFFFF" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#80FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#14FFFFFF" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
