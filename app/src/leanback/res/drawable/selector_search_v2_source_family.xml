<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true" android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#6633151C" />
            <corners android:radius="10dp" />
            <stroke android:width="2dp" android:color="@color/tv_focus_border" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#4230151B" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="@color/tv_accent_focused" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#5233171D" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="@color/tv_focus_border" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#14FFFFFF" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
