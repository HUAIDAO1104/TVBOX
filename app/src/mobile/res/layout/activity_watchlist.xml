<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/mobile_background">
<com.google.android.material.appbar.MaterialToolbar android:id="@+id/mobileToolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" app:title="我的追剧" app:titleTextColor="@color/mobile_text"><com.google.android.material.button.MaterialButton android:id="@+id/checkUpdates" style="@style/Mobile.Action" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_gravity="end" android:text="检查更新"/></com.google.android.material.appbar.MaterialToolbar>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:layout_marginHorizontal="16dp" android:background="@drawable/mobile_panel">
<com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/reminders" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="新剧集通知" android:textColor="@color/mobile_text" android:textSize="16sp"/>
<TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="当前订阅载入后检查更新；后台检查由系统安排。" android:textSize="12sp" android:textColor="@color/mobile_muted" android:lineSpacingExtra="4dp"/>
</LinearLayout>
<EditText android:id="@+id/search" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_margin="16dp" android:paddingHorizontal="16dp" android:background="@drawable/mobile_panel" android:hint="搜索追剧" android:singleLine="true" android:inputType="text" android:textColor="@color/mobile_text" android:textColorHint="@color/mobile_muted" android:textSize="15sp"/>
<com.google.android.material.tabs.TabLayout android:id="@+id/tabs" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/mobile_background" app:tabMode="scrollable" app:tabSelectedTextColor="@color/mobile_accent" app:tabTextColor="@color/mobile_muted"/>
<TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="32dp" android:gravity="center" android:lineSpacingExtra="8dp" android:textSize="16sp" android:textColor="@color/mobile_muted"/>
<androidx.recyclerview.widget.RecyclerView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:padding="8dp" android:clipToPadding="false" app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
</LinearLayout>