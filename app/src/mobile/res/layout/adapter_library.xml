<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="8dp" android:layout_marginBottom="12dp" android:background="@drawable/mobile_panel" android:padding="12dp" android:orientation="horizontal" android:gravity="center_vertical" android:focusable="true">
<com.google.android.material.imageview.ShapeableImageView android:id="@+id/image" android:layout_width="80dp" android:layout_height="112dp" android:scaleType="centerCrop" android:background="@drawable/mobile_cover" android:importantForAccessibility="no" app:shapeAppearanceOverlay="@style/Vod.Grid.Large"/>
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="14dp">
<TextView android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="3" android:ellipsize="end" android:textSize="17sp" android:textColor="@color/mobile_text" android:fontFamily="sans-serif-medium"/>
<TextView android:id="@+id/site" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="12sp" android:textColor="@color/mobile_muted"/>
<TextView android:id="@+id/remark" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="13sp" android:textColor="@color/mobile_text"/>
<com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/progress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:trackThickness="3dp" app:trackStopIndicatorSize="0dp" app:trackCornerRadius="2dp"/>
<TextView android:id="@+id/delete" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical" android:text="移除此记录" android:textSize="14sp" android:textColor="@color/mobile_accent" android:visibility="gone"/>
</LinearLayout></LinearLayout>