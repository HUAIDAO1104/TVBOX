<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@color/mobile_background">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
<TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="字幕与弹幕" android:textSize="22sp" android:fontFamily="sans-serif-medium" android:textColor="@color/mobile_text"/>
<ImageButton android:id="@+id/close" style="@style/Mobile.Icon" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_mobile_close" android:contentDescription="关闭字幕与弹幕"/>
</LinearLayout><androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="false"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="16dp" android:padding="16dp" android:background="@drawable/mobile_panel"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="字幕" android:textSize="18sp" android:textColor="@color/mobile_text" android:fontFamily="sans-serif-medium"/><TextView android:id="@+id/subtitleStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="14sp" android:textColor="@color/mobile_muted" android:lineSpacingExtra="4dp"/><TextView android:id="@+id/subtitleOffset" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="13sp" android:textColor="@color/mobile_accent"/>
<com.google.android.material.button.MaterialButton android:id="@+id/subtitleChoose" style="@style/Mobile.Action" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="start|center_vertical" android:text="选择 / 导入字幕"/>
<com.google.android.material.button.MaterialButton android:id="@+id/subtitleEarlier" style="@style/Mobile.Action" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="start|center_vertical" android:text="字幕提前 0.5 秒"/>
<com.google.android.material.button.MaterialButton android:id="@+id/subtitleLater" style="@style/Mobile.Action" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="start|center_vertical" android:text="字幕延后 0.5 秒"/>
<com.google.android.material.button.MaterialButton android:id="@+id/subtitleReset" style="@style/Mobile.Action" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="start|center_vertical" android:text="重置字幕同步"/>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="16dp" android:padding="16dp" android:background="@drawable/mobile_panel"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="弹幕" android:textSize="18sp" android:textColor="@color/mobile_text" android:fontFamily="sans-serif-medium"/><TextView android:id="@+id/danmakuStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="14sp" android:textColor="@color/mobile_muted" android:lineSpacingExtra="4dp"/><TextView android:id="@+id/danmakuOffset" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="13sp" android:textColor="@color/mobile_accent"/>
<com.google.android.material.button.MaterialButton android:id="@+id/danmakuToggle" style="@style/Mobile.Action" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="start|center_vertical" android:text="显示弹幕"/>
<com.google.android.material.button.MaterialButton android:id="@+id/danmakuSearch" style="@style/Mobile.Action" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="start|center_vertical" android:text="重新匹配影片与集数"/>
<com.google.android.material.button.MaterialButton android:id="@+id/danmakuChoose" style="@style/Mobile.Action" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="start|center_vertical" android:text="选择来源 / 导入本地 XML"/>
<com.google.android.material.button.MaterialButton android:id="@+id/danmakuEarlier" style="@style/Mobile.Action" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="start|center_vertical" android:text="弹幕提前 0.5 秒"/>
<com.google.android.material.button.MaterialButton android:id="@+id/danmakuLater" style="@style/Mobile.Action" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="start|center_vertical" android:text="弹幕延后 0.5 秒"/>
<com.google.android.material.button.MaterialButton android:id="@+id/danmakuReset" style="@style/Mobile.Action" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="start|center_vertical" android:text="重置弹幕同步"/>
<com.google.android.material.button.MaterialButton android:id="@+id/danmakuStyle" style="@style/Mobile.Action" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="start|center_vertical" android:text="弹幕外观与高级设置"/>
</LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:text="正数表示延后显示，负数表示提前显示。投屏到电视时，字幕与弹幕是否显示取决于接收端的支持。" android:textSize="12sp" android:textColor="@color/mobile_muted"/></LinearLayout></androidx.core.widget.NestedScrollView></LinearLayout>