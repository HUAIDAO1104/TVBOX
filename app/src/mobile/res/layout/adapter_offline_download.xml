<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:background="@drawable/mobile_panel" android:padding="14dp" android:orientation="vertical" android:foreground="?attr/selectableItemBackground" android:focusable="true" android:clickable="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
    <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/check" android:layout_width="48dp" android:layout_height="48dp" android:visibility="gone" android:clickable="false" android:focusable="false" android:importantForAccessibility="no" />
    <TextView android:id="@+id/cover" android:layout_width="58dp" android:layout_height="76dp" android:background="@drawable/mobile_cover" android:gravity="center" android:text="离线" android:textColor="@color/mobile_text" android:textSize="15sp" android:fontFamily="sans-serif-medium" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:orientation="vertical">
      <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end" android:textColor="@color/mobile_text" android:textSize="16sp" android:fontFamily="sans-serif-medium" />
      <TextView android:id="@+id/episode" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:maxLines="1" android:ellipsize="end" android:textColor="@color/mobile_muted" android:textSize="13sp" />
      <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="@color/mobile_accent" android:textSize="12sp" />
    </LinearLayout>
    <ImageButton android:id="@+id/action" style="@style/Mobile.Icon" android:src="@drawable/ic_mobile_play" android:contentDescription="播放或暂停下载" />
    <ImageButton android:id="@+id/more" style="@style/Mobile.Icon" android:src="@drawable/ic_offline_more" android:contentDescription="更多下载操作" />
  </LinearLayout>
  <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/progress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:max="100" app:trackCornerRadius="2dp" app:trackThickness="3dp" app:trackStopIndicatorSize="0dp" app:trackColor="#38414E" />
  <TextView android:id="@+id/size" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/mobile_muted" android:textSize="12sp" />
  <TextView android:id="@+id/extras" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/mobile_muted" android:textSize="12sp" />
</LinearLayout>