<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:layout_marginTop="8dp" android:orientation="horizontal" android:padding="14dp" android:gravity="center_vertical" android:background="@drawable/mobile_panel" android:focusable="true">
<CheckBox android:id="@+id/check" android:layout_width="48dp" android:layout_height="48dp" android:clickable="false" android:focusable="false" android:importantForAccessibility="no" android:visibility="gone"/>
<com.google.android.material.imageview.ShapeableImageView android:id="@+id/poster" android:layout_width="62dp" android:layout_height="86dp" android:scaleType="centerCrop" android:background="@drawable/mobile_cover" android:importantForAccessibility="no" app:shapeAppearanceOverlay="@style/Vod.Grid.Large"/>
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:paddingStart="12dp" android:orientation="vertical">
<TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="3" android:ellipsize="end" android:textSize="18sp" android:fontFamily="sans-serif-medium" android:textColor="@color/mobile_text"/>
<TextView android:id="@+id/summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="12sp" android:textColor="@color/mobile_muted"/>
<TextView android:id="@+id/expand" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="36dp" android:gravity="center_vertical" android:layout_marginTop="2dp" android:textSize="13sp" android:textColor="@color/mobile_accent"/>
</LinearLayout></LinearLayout>