<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
  <com.google.android.material.appbar.MaterialToolbar android:id="@+id/mobileToolbar" android:layout_width="match_parent" android:layout_height="56dp" app:title="@string/repository_title" />
  <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="160dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="16dp">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/mobile_muted" android:textSize="18sp" android:layout_marginTop="6dp" android:id="@+id/title" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/mobile_muted" android:textSize="12sp" android:layout_marginTop="6dp" android:id="@+id/url" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/mobile_muted" android:textSize="12sp" android:layout_marginTop="6dp" android:id="@+id/meta" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/mobile_muted" android:textSize="12sp" android:layout_marginTop="6dp" android:id="@+id/flags" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/mobile_muted" android:textSize="12sp" android:layout_marginTop="6dp" android:id="@+id/sync_info" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/mobile_muted" android:textSize="12sp" android:layout_marginTop="6dp" android:id="@+id/type" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/mobile_muted" android:textSize="12sp" android:layout_marginTop="6dp" android:id="@+id/status" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/mobile_muted" android:textSize="12sp" android:layout_marginTop="6dp" android:id="@+id/cache" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/mobile_muted" android:textSize="12sp" android:layout_marginTop="6dp" android:id="@+id/error" />
    </LinearLayout>
  </androidx.core.widget.NestedScrollView>
  <com.google.android.material.button.MaterialButton android:id="@+id/refresh" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/repository_refresh" style="@style/Widget.Material3.Button.TextButton" />
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/mobile_muted" android:textSize="14sp" android:layout_marginTop="6dp" android:id="@+id/empty" android:text="@string/repository_item_empty" android:visibility="gone" />
  <com.fongmi.android.tv.ui.custom.CustomRecyclerView android:id="@+id/recycler" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:padding="16dp" android:clipToPadding="false" app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
</LinearLayout>
