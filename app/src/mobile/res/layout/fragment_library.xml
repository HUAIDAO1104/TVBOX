<?xml version='1.0' encoding='UTF-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="56dp" app:title="@string/mobile_library" app:titleTextAppearance="@style/ToolbarTextAppearance">
        <com.google.android.material.button.MaterialButton android:id="@+id/manage" style="@style/Mobile.Action" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_gravity="end" android:layout_marginEnd="0dp" android:text="@string/mobile_manage" app:icon="@drawable/ic_mobile_settings" />
    </com.google.android.material.appbar.MaterialToolbar>
    <com.google.android.material.tabs.TabLayout android:id="@+id/tabs" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/mobile_background" app:tabMode="fixed" app:tabSelectedTextColor="@color/mobile_text" app:tabTextColor="@color/mobile_muted" style="@style/Mobile.Tabs" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingHorizontal="8dp" android:paddingBottom="16dp" android:clipToPadding="false" />
        <LinearLayout android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="32dp" android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/mobile_library_empty" android:textSize="20sp" android:textColor="@color/mobile_text" />
            <TextView android:id="@+id/hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:textSize="14sp" android:textColor="@color/mobile_muted" />
            <com.google.android.material.button.MaterialButton android:id="@+id/browse" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="24dp" android:text="@string/mobile_browse" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
