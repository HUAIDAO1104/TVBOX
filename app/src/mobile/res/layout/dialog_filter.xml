<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
<TextView style="@style/Mobile.Section" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="筛选影片"/>
<androidx.appcompat.widget.AppCompatImageButton android:id="@+id/close" style="@style/Mobile.Icon" android:src="@drawable/ic_mobile_close" android:contentDescription="关闭筛选"/>
</LinearLayout>
<androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="16dp" app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
</LinearLayout>
