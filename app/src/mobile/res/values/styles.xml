<resources>

    <style name="Theme.Base" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/mobile_background</item>
        <item name="android:colorBackground">@color/mobile_background</item>
        <item name="colorSurface">@color/mobile_surface</item>
        <item name="colorOnSurface">@color/mobile_text</item>
        <item name="colorOnPrimary">@color/mobile_background</item>
        <item name="colorOnSecondaryContainer">@color/mobile_text</item>
        <item name="colorSecondaryContainer">@color/mobile_surface</item>
        <item name="colorOnSurfaceVariant">@color/mobile_muted</item>
        <item name="materialButtonStyle">@style/Mobile.Button</item>
        <item name="bottomSheetDialogTheme">@style/Mobile.SheetTheme</item>
        <item name="colorOutline">@color/mobile_outline</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:navigationBarColor">@color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="colorPrimary">@color/mobile_accent</item>
        <item name="colorSecondary">@color/mobile_accent</item>
        <item name="colorTertiary">@color/mobile_accent</item>
        <item name="colorControlActivated">@color/mobile_accent</item>
        <item name="android:colorAccent">@color/mobile_accent</item>
    </style>

    <style name="Theme.Splash" parent="Theme.SplashScreen">
        <item name="postSplashScreenTheme">@style/Theme.App</item>
        <item name="windowSplashScreenBackground">@color/mobile_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/brand_mark</item>
    </style>

    <style name="Theme.App" parent="Theme.Base" />

    <style name="Theme.Crash" parent="Theme.Base">
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowBackground">@color/grey_700</item>
    </style>

    <style name="Control">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:textColor">@color/mobile_accent</item>
        <item name="android:textSize">14sp</item>
        <item name="android:padding">8dp</item>
    </style>

    <style name="ToolbarTextAppearance" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/mobile_text</item>
        <item name="titleTextColor">@color/mobile_text</item>
    </style>


    <style name="Mobile.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">48dp</item><item name="android:textSize">14sp</item><item name="android:textAllCaps">false</item><item name="cornerRadius">12dp</item><item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Mobile.Action" parent="Widget.Material3.Button.TextButton">
        <item name="iconGravity">textStart</item>
        <item name="android:minHeight">48dp</item><item name="android:textSize">13sp</item><item name="android:textColor">@color/mobile_text</item><item name="iconTint">@color/mobile_muted</item><item name="iconSize">20dp</item><item name="iconPadding">8dp</item><item name="android:paddingLeft">10dp</item><item name="android:paddingRight">10dp</item><item name="android:insetLeft">0dp</item><item name="android:insetRight">0dp</item><item name="cornerRadius">10dp</item>
    </style>
    <style name="Mobile.Icon" parent="">
        <item name="android:layout_width">48dp</item><item name="android:layout_height">48dp</item><item name="android:padding">12dp</item><item name="android:background">?attr/selectableItemBackgroundBorderless</item><item name="android:clickable">true</item><item name="android:focusable">true</item>
    </style>
    <style name="Mobile.Section" parent="">
        <item name="android:textSize">18sp</item><item name="android:textColor">@color/mobile_text</item><item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Mobile.Tabs" parent="Widget.Material3.TabLayout">
        <item name="tabIndicatorAnimationDuration">0</item>
        <item name="tabIndicatorFullWidth">false</item><item name="tabIndicatorHeight">3dp</item><item name="tabSelectedTextColor">@color/mobile_text</item><item name="tabTextColor">@color/mobile_muted</item><item name="tabIndicatorColor">@color/mobile_accent</item><item name="tabMinWidth">64dp</item><item name="tabRippleColor">#22FFFFFF</item>
    </style>
    <style name="Mobile.SheetTheme" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Mobile.Sheet</item>
    </style>
    <style name="Mobile.Sheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/mobile_background</item><item name="shapeAppearanceOverlay">@style/Mobile.SheetShape</item>
    </style>
    <style name="Mobile.SheetShape" parent=""><item name="cornerFamily">rounded</item><item name="cornerSizeTopLeft">24dp</item><item name="cornerSizeTopRight">24dp</item></style>
<style name="Mobile.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator"><item name="android:color">#22FF6575</item><item name="android:width">56dp</item><item name="android:height">30dp</item></style>
</resources>
