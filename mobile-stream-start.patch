+            assertArrayEquals(ts, response.body().bytes());
+        }
+    }
+
+    @Test public void bomPlaylistIsRecognizedAndReturnedAsHls() throws Exception {
+        handler = request -> text("text/plain", "\uFEFF#EXTM3U\n#EXTINF:2,\na.ts\n#EXT-X-ENDLIST\n");
