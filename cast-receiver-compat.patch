+        }
         if ((System.nanoTime() - startTime) / 1_000_000L > 40_000) {
             fail(session.hasMedia() ? "电视已收到视频但尚未开始播放，请尝试兼容线路或电视版接收端"
                     : "电视未能读取视频，请检查网络或更换线路");
